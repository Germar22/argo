      object daSQL1: TdaSQL
        DatabaseName = 'ADOConnection'
        DatabaseType = dtMySQL
        DataPipelineName = 'qryArAgingMedicalDialysis'
        EditSQLAsText = True
        IsCaseSensitive = True
        LinkColor = clMaroon
        LinkType = ltParameterizedSQL
        MaxSQLFieldAliasLength = 0
        SQLText.Strings = (
          'SELECT'
          '    c.ID AS CUSTOMER_ID,'
          '    c.NAME AS CUSTOMER_NAME,'
          '    SUM(CASE WHEN DATEDIFF(CURDATE(), COALESCE(i.DUE_DATE, i.DATE)) <= 0 THEN i.BALANCE_DUE ELSE 0 END) AS DIALYSIS_CURRENT,'
          '    SUM(CASE WHEN DATEDIFF(CURDATE(), COALESCE(i.DUE_DATE, i.DATE)) BETWEEN 1 AND 30 THEN i.BALANCE_DUE ELSE 0 END) AS DIALYSIS_1_30,'
          '    SUM(CASE WHEN DATEDIFF(CURDATE(), COALESCE(i.DUE_DATE, i.DATE)) BETWEEN 31 AND 60 THEN i.BALANCE_DUE ELSE 0 END) AS DIALYSIS_31_60,'
          '    SUM(CASE WHEN DATEDIFF(CURDATE(), COALESCE(i.DUE_DATE, i.DATE)) BETWEEN 61 AND 90 THEN i.BALANCE_DUE ELSE 0 END) AS DIALYSIS_61_90,'
          '    SUM(CASE WHEN DATEDIFF(CURDATE(), COALESCE(i.DUE_DATE, i.DATE)) > 90 THEN i.BALANCE_DUE ELSE 0 END) AS DIALYSIS_OVER_90,'
          '    SUM(i.BALANCE_DUE) AS DIALYSIS_TOTAL,'
          '    0 AS MEDICAL_CURRENT,'
          '    0 AS MEDICAL_1_30,'
          '    0 AS MEDICAL_31_60,'
          '    0 AS MEDICAL_61_90,'
          '    0 AS MEDICAL_OVER_90,'
          '    0 AS MEDICAL_TOTAL,'
          '    SUM(i.BALANCE_DUE) AS GRAND_TOTAL'
          'FROM invoice i'
          'INNER JOIN contact c ON c.ID = i.CUSTOMER_ID'
          'WHERE COALESCE(i.BALANCE_DUE, 0) <> 0'
          '  AND i.CLASS_ID = 2'
          'GROUP BY c.ID, c.NAME'
          'ORDER BY c.NAME'
        )
        SQLType = sqSQL2
        object daField1: TdaField
          Alias = 'CUSTOMER_ID'
          DataType = dtInteger
          DisplayWidth = 10
          FieldAlias = 'CUSTOMER_ID'
