      raProgram.ProgramName = 'FormatReportTitle'
      raProgram.ProgramType = ttProcedure
      raProgram.Source = 
        'procedure FormatReportTitle;'#13#10'var'#13#10'  S: string;'#13#10'  Sep: string;'#13 +
        #10'  ChrWidth: Single;'#13#10'  CoNameWidth: Single;'#13#10'  CoNameLeft: Sing' +
        'le;'#13#10'  CoContactInfoWidth: Single;'#13#10'  CoContactInfoLeft: Single;' +
        #13#10'  BandWidth: Single;'#13#10'  ByPass: Boolean;'#13#10'begin'#13#10'  BandWidth :' +
        '= (CompanyAddress.Left + CompanyAddress.Width);'#13#10'  S := Report.P' +
        'arameters['#39'CompanyName'#39'];'#13#10'  if not ByPass then'#13#10'  begin'#13#10'    Ch' +
        'rWidth := CompanyName.Width / Length(CompanyName.Text);'#13#10'    CoN' +
        'ameWidth:= ChrWidth * (Length(S) - 1);'#13#10'    CoNameLeft := Compan' +
        'yName.Left + (CompanyName.Width - CoNameWidth);'#13#10'  end;'#13#10'  Heade' +
        'rBar.Left := CoNameLeft;'#13#10'  HeaderBar.Width := BandWidth - Heade' +
        'rBar.Left;'#13#10'  CompanyName.Text := S;'#13#10'  '#13#10'  CompanyAddress.Lines' +
        '.Clear;'#13#10'  CompanyAddress.Lines.Add(Report.Parameters['#39'CompanyAd' +
        'dress'#39']);'#13#10'  S := '#39#39';'#13#10'  Sep := '#39' '#8226' '#39';'#13#10'  if Report.Parameters['#39 +
        'CompanyEmailAddress'#39'] <> '#39#39' then'#13#10'    S := Report.Parameters['#39'Co' +
        'mpanyEmailAddress'#39'];'#13#10'  if Report.Parameters['#39'CompanyPhoneNo'#39'] <' +
        '> '#39#39' then'#13#10'  begin'#13#10'    if S <> '#39#39' then S := S + Sep;'#13#10'    S := ' +
        'S + '#39'Phone '#39' + Report.Parameters['#39'CompanyPhoneNo'#39'];'#13#10'  end;'#13#10'  i' +
        'f Report.Parameters['#39'CompanyMobileNo'#39'] <> '#39#39' then'#13#10'  begin'#13#10'    ' +
        'if S <> '#39#39' then S := S + Sep;'#13#10'    S := S + '#39'Mobile '#39' +  Report.' +
        'Parameters['#39'CompanyMobileNo'#39'];'#13#10'  end;'#13#10'  if Report.Parameters['#39 +
        'CompanyFaxNo'#39'] <> '#39#39' then'#13#10'  begin'#13#10'    if S <> '#39#39' then S := S +' +
        ' Sep;'#13#10'    S := S + '#39'Fax '#39' +  Report.Parameters['#39'CompanyFaxNo'#39'];' +
        #13#10'  end;'#13#10'  if Report.Parameters['#39'CompanyTin'#39'] <> '#39#39' then'#13#10'  beg' +
        'in'#13#10'    if S <> '#39#39' then S := S + Sep;'#13#10'    S := S + '#39'Tin '#39' +  Re' +
        'port.Parameters['#39'CompanyTin'#39'];'#13#10'  end;'#13#10'  CompanyContactInfo.Tex' +
        't := S;'#13#10'  '#13#10'  if not ByPass then'#13#10'  begin'#13#10'    ChrWidth := Comp' +
        'anyContactInfo.Width / Length(CompanyContactInfo.Text);'#13#10'    CoC' +
        'ontactInfoWidth := ChrWidth * (Length(S) - 1);'#13#10'    CoContactInf' +
        'oLeft := CompanyContactInfo.Left + '#13#10'      (CompanyContactInfo.W' +
        'idth - CoContactInfoWidth);'#13#10'  end;'#13#10'  if CoContactInfoLeft < He' +
        'aderBar.Left then'#13#10'  begin'#13#10'    HeaderBar.Left := CoContactInfoL' +
        'eft;'#13#10'    HeaderBar.Width := BandWidth - HeaderBar.Left;'#13#10'  end;' +
        #13#10'  '#13#10'  ByPass := True;'#13#10'end;'#13#10
    end
