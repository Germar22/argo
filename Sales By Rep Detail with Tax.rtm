      raProgram.Source = 
        'procedure FormatDateRange;'#13#10'var'#13#10'  YearFrom: Integer;'#13#10'  MonthFr' +
        'om: Integer;'#13#10'  DayFrom: Integer;'#13#10'  YearTo: Integer;'#13#10'  MonthTo' +
        ': Integer;'#13#10'  DayTo: Integer;'#13#10'  RangeFrom: TDateTime;'#13#10'  RangeT' +
        'o: TDateTime;'#13#10'  S: string;'#13#10'begin'#13#10'  if Report.Parameters.InLis' +
        't('#39'RangeTo'#39') then'#13#10'  begin'#13#10'    RangeFrom := Report.Parameters['#39 +
        'RangeFrom'#39'];'#13#10'    RangeTo := Report.Parameters['#39'RangeTo'#39'];'#13#10'    ' +
        'DecodeDate(RangeFrom, YearFrom, MonthFrom, DayFrom);'#13#10'    Decode' +
        'Date(RangeTo, YearTo, MonthTo, DayTo);'#13#10'    if YearFrom = YearTo' +
        ' then'#13#10'    begin'#13#10'      if MonthFrom = MonthTo then'#13#10'      begin' +
        #13#10'        if DayFrom = DayTo then'#13#10'          S := FormatDateTime' +
        '('#39'mmmm d, yyyy'#39', RangeTo)'#13#10'        else'#13#10'          S := FormatDa' +
        'teTime('#39'mmmm '#39' + IntToStr(DayFrom) +'#13#10'            '#39' - '#39' + IntToS' +
        'tr(DayTo)  + '#39', yyyy'#39', RangeTo);'#13#10'      end'#13#10'      else'#13#10'      b' +
        'egin'#13#10'        S := FormatDateTime('#39'mmmm d'#39', RangeFrom);'#13#10'       ' +
        ' S := S + '#39' through '#39' + FormatDateTime('#39'mmmm d, yyyy'#39', RangeTo);' +
        #13#10'      end;'#13#10'    end'#13#10'    else'#13#10'    begin'#13#10'      S := FormatDat' +
        'eTime('#39'mmmm d, yyyy'#39', RangeFrom);'#13#10'      S := S + '#39' through '#39' + ' +
        'FormatDateTime('#39'mmmm d, yyyy'#39', RangeTo);'#13#10'    end;'#13#10'    DateRang' +
        'eLabel.Text := S;'#13#10'  end'#13#10'  else'#13#10'    DateRangeLabel.Text := '#39'Al' +
        'l transactions'#39';'#13#10'end;'#13#10
    end
