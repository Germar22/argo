      object daSQL1: TdaSQL
        DatabaseName = 'ADOConnection'
        DatabaseType = dtMySQL
        DataPipelineName = 'qryAgingByArea'
        EditSQLAsText = True
        IsCaseSensitive = True
        LinkColor = clMaroon
        LinkType = ltManualSQL
        MaxSQLFieldAliasLength = 0
        SQLText.Strings = (
          'WITH base AS ('
          '    SELECT'
          '        m.AREA_CODE,'
          '        c.ID AS CUSTOMER_ID,'
          '        c.NAME AS CUSTOMER_NAME,'
          '        i.ID AS INVOICE_ID,'
          '        i.DUE_DATE,'
          '        i.BALANCE_DUE,'
          '        CASE'
          '            WHEN i.DUE_DATE IS NULL THEN NULL'
          '            ELSE DATEDIFF(CURDATE(), i.DUE_DATE)'
          '        END AS DAYS_PAST_DUE'
          '    FROM invoice i'
          '    INNER JOIN contact c ON c.ID = i.CUSTOMER_ID'
          
            '    INNER JOIN customer_area_mapping m ON m.CUSTOMER_ID = i.CUST' +
            'OMER_ID'
          '    WHERE i.BALANCE_DUE > 0'
          '), customer_rows AS ('
          '    SELECT'
          '        AREA_CODE,'
          '        CUSTOMER_ID,'
          '        CUSTOMER_NAME,'
          '        COUNT(INVOICE_ID) AS OPEN_INVOICE_COUNT,'
          
            '        SUM(CASE WHEN DUE_DATE IS NOT NULL AND DAYS_PAST_DUE <= ' +
            '0 THEN BALANCE_DUE ELSE 0 END) AS CURRENT_BALANCE,'
          
            '        SUM(CASE WHEN DUE_DATE IS NOT NULL AND DAYS_PAST_DUE BET' +
            'WEEN 1 AND 30 THEN BALANCE_DUE ELSE 0 END) AS DAYS_1_30,'
          
            '        SUM(CASE WHEN DUE_DATE IS NOT NULL AND DAYS_PAST_DUE BET' +
            'WEEN 31 AND 60 THEN BALANCE_DUE ELSE 0 END) AS DAYS_31_60,'
          
            '        SUM(CASE WHEN DUE_DATE IS NOT NULL AND DAYS_PAST_DUE BET' +
            'WEEN 61 AND 90 THEN BALANCE_DUE ELSE 0 END) AS DAYS_61_90,'
          
            '        SUM(CASE WHEN DUE_DATE IS NOT NULL AND DAYS_PAST_DUE BET' +
            'WEEN 91 AND 120 THEN BALANCE_DUE ELSE 0 END) AS DAYS_91_120,'
          
            '        SUM(CASE WHEN DUE_DATE IS NOT NULL AND DAYS_PAST_DUE > 1' +
            '20 THEN BALANCE_DUE ELSE 0 END) AS DAYS_OVER_120,'
          
            '        SUM(CASE WHEN DUE_DATE IS NULL THEN BALANCE_DUE ELSE 0 E' +
            'ND) AS UNDATED_BALANCE,'
          '        SUM(BALANCE_DUE) AS TOTAL_BALANCE,'
          '        1 AS SORT_ORDER'
          '    FROM base'
          '    GROUP BY AREA_CODE, CUSTOMER_ID, CUSTOMER_NAME'
          '), area_rows AS ('
          '    SELECT'
          '        AREA_CODE,'
          '        NULL AS CUSTOMER_ID,'
          '        '#39'AREA TOTAL'#39' AS CUSTOMER_NAME,'
          '        SUM(OPEN_INVOICE_COUNT) AS OPEN_INVOICE_COUNT,'
          '        SUM(CURRENT_BALANCE) AS CURRENT_BALANCE,'
          '        SUM(DAYS_1_30) AS DAYS_1_30,'
          '        SUM(DAYS_31_60) AS DAYS_31_60,'
          '        SUM(DAYS_61_90) AS DAYS_61_90,'
          '        SUM(DAYS_91_120) AS DAYS_91_120,'
          '        SUM(DAYS_OVER_120) AS DAYS_OVER_120,'
          '        SUM(UNDATED_BALANCE) AS UNDATED_BALANCE,'
          '        SUM(TOTAL_BALANCE) AS TOTAL_BALANCE,'
          '        2 AS SORT_ORDER'
          '    FROM customer_rows'
          '    GROUP BY AREA_CODE'
          '), grand_row AS ('
          '    SELECT'
          '        '#39'GRAND TOTAL'#39' AS AREA_CODE,'
          '        NULL AS CUSTOMER_ID,'
          '        '#39'GRAND TOTAL'#39' AS CUSTOMER_NAME,'
          '        SUM(OPEN_INVOICE_COUNT) AS OPEN_INVOICE_COUNT,'
          '        SUM(CURRENT_BALANCE) AS CURRENT_BALANCE,'
          '        SUM(DAYS_1_30) AS DAYS_1_30,'
          '        SUM(DAYS_31_60) AS DAYS_31_60,'
          '        SUM(DAYS_61_90) AS DAYS_61_90,'
          '        SUM(DAYS_91_120) AS DAYS_91_120,'
          '        SUM(DAYS_OVER_120) AS DAYS_OVER_120,'
          '        SUM(UNDATED_BALANCE) AS UNDATED_BALANCE,'
          '        SUM(TOTAL_BALANCE) AS TOTAL_BALANCE,'
          '        3 AS SORT_ORDER'
          '    FROM customer_rows'
          ')'
          'SELECT'
          '    AREA_CODE,'
          '    CUSTOMER_ID,'
          '    CUSTOMER_NAME,'
          '    OPEN_INVOICE_COUNT,'
          '    CURRENT_BALANCE,'
          '    DAYS_1_30,'
          '    DAYS_31_60,'
          '    DAYS_61_90,'
          '    DAYS_91_120,'
          '    DAYS_OVER_120,'
          '    UNDATED_BALANCE,'
          '    TOTAL_BALANCE'
          'FROM ('
          '    SELECT * FROM customer_rows'
          '    UNION ALL'
          '    SELECT * FROM area_rows'
          '    UNION ALL'
          '    SELECT * FROM grand_row'
          ') report_rows'
          'ORDER BY'
          '    CASE AREA_CODE'
          '        WHEN '#39'DAVAO'#39' THEN 1'
          '        WHEN '#39'GENSAN'#39' THEN 2'
          '        WHEN '#39'NORTH'#39' THEN 3'
          '        WHEN '#39'SOUTH'#39' THEN 4'
          '        WHEN '#39'GRAND TOTAL'#39' THEN 5'
          '        ELSE 6'
          '    END,'
          '    SORT_ORDER,'
          '    CUSTOMER_NAME;')
        SQLType = sqSQL2
        object daField1: TdaField
          Alias = 'AREA_CODE'
          DisplayWidth = 30
          FieldAlias = 'AREA_CODE'
          FieldLength = 30
          FieldName = 'AREA_CODE'
          SQLFieldName = 'AREA_CODE'
        end
